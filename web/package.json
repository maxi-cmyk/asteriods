{
  "name": "asteroids-oled-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --test --oled && node build.mjs --test && node --test tests/*.test.mjs",
    "start": "node serve.mjs",
    "format": "prettier --write \"**/*.{mjs,css}\"",
    "lint": "eslint .",
    "check": "prettier --check \"**/*.{mjs,css}\" && eslint . && npm test"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
